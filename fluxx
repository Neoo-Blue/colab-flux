subprocess.Popen(["sh", "-c", "python3 {REMOTE}/remote_job.py > {REMOTE}/worker.log 2>&1"], start_new_session=True)
print(BEGIN); print("{{}}"); print(END)
'''
# JOB is prepended. The job's own progress once the worker picked it up, the worker's setup stage before that.
