HEARTBEAT = f'''
import os, time
p = "{REMOTE}/heartbeat"
print(BEGIN); print(json.dumps({{"age": time.time() - float(open(p).read()) if os.path.exists(p) else 1e9}})); print(END)
'''
CONFIG_DEFAULTS = {"keep_minutes": 5, "candidates": 3}


def config() -> dict:
    p = HOME / "config.json"
    return {**CONFIG_DEFAULTS, **(json.loads(p.read_text()) if p.exists() else {})}


def _kill_watchdog(session: str) -> None:
    pidfile = STATE / f"watchdog-{session}.pid"
    try:
        os.killpg(int(pidfile.read_text()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    pidfile.unlink(missing_ok=True)


def _raise_interrupt(signum, _frame):
    raise KeyboardInterrupt(f"signal {signum}")


def warm_file(session: str) -> Path:
    return STATE / f"warm-{session}.json"


def arm_watchdog(session: str, seconds: float) -> None:
    """(Re)start the detached timer that stops the GPU, whatever happens to this process."""
    _kill_watchdog(session)
    wd = subprocess.Popen(["sh", "-c", f"sleep {int(seconds)}; colab stop -s {session}; rm -f '{warm_file(session)}'"],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                          env=colab_env())
    (STATE / f"watchdog-{session}.pid").write_text(str(wd.pid))


def warm_alive(session: str, mode: dict) -> bool:
    """A GPU kept warm by an earlier run, with the same model setup, whose worker is still beating."""
    p = warm_file(session)
    try:
        w = json.loads(p.read_text())
    except (OSError, ValueError):
        return False
    if w.get("mode") != mode or w.get("until", 0) < time.time() + 30:
        return False
    if f"[{session}]" not in colab("sessions", check=False, timeout=60).stdout:
        return False
    try:
        return rexec(session, HEARTBEAT, 60)["age"] < 60
    except FluxxError:
        return False


@contextlib.contextmanager
def gpu_session(args, mode: dict):
    """A GPU for the block: a warm one from an earlier run when it matches, else a new one. Afterwards it is
    stopped, or on success with --keep N kept warm for N minutes under a watchdog. Yields {rate, warm, keep}."""
    if not shutil.which("colab"):
        raise FluxxError("Colab CLI not installed: run install.sh, or `uv tool install google-colab-cli`")
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / f"{args.session}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise FluxxError(f"another fluxx run holds session '{args.session}'; wait, or use -s NAME")
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _raise_interrupt)
    t0, info = time.time(), {"warm": warm_alive(args.session, mode)}
    warm_file(args.session).unlink(missing_ok=True)  # in use now; written again only if kept warm after
    arm_watchdog(args.session, args.max_minutes * 60)
    try:
        if info["warm"]:
            log(f"reusing the warm GPU '{args.session}': FLUX 3 is already loaded")
        else:
            gpus = [g.strip() for g in args.gpu.split(",") if g.strip()] or ["A100"]
            for i, gpu in enumerate(gpus):  # in order: a busy card ("Service Unavailable") falls through
                colab("stop", "-s", args.session, check=False, timeout=90)
                log(f"allocating {gpu} as session '{args.session}' (watchdog stops it at {args.max_minutes:g} min)")
                hm = args.high_mem and gpu.upper() in ("A100", "T4")
                try:
                    colab("new", "-s", args.session, "--gpu", gpu, *(["--high-mem"] if hm else []), timeout=600)
                    break
                except FluxxError as e:
                    if i == len(gpus) - 1:
                        raise
                    log(f"{gpu} not available ({str(e).splitlines()[-1][-160:]}); trying {gpus[i + 1]}")
            log(f"VM up on {gpu} in {time.time() - t0:.0f}s")
        m = re.search(r"Usage rate:\s*([\d.]+)", colab("usage", check=False, timeout=60).stdout)
        info["rate"] = float(m.group(1)) if m else None
        yield info
    finally:
        signal.signal(signal.SIGINT, signal.SIG_IGN)  # nothing may interrupt the stop
        rate = info.get("rate")
        mins = (time.time() - t0) / 60
        cost = f" ~{rate * mins / 60:.2f} compute units at {rate:g}/h" if rate else ""
        if info.get("keep") and args.keep > 0:
            arm_watchdog(args.session, args.keep * 60)
            warm_file(args.session).write_text(json.dumps({"mode": mode, "until": time.time() + args.keep * 60}))
            idle = f", ~{rate * args.keep / 60:.2f} more if it sits idle" if rate else ""
            log(f"this run took {mins:.1f} min{cost}")
            log(f"GPU KEPT WARM for {args.keep:g} min{idle}: the next `fluxx gen` with the same setup starts "
                f"rendering at once. `fluxx stop` releases it now; otherwise it stops by itself.")
        else:
            stopped = False
            for attempt in range(3):
                if colab("stop", "-s", args.session, check=False, timeout=120).returncode == 0:
                    stopped = True
                    break
                time.sleep(2 ** attempt)
            if not stopped:
                r = colab("sessions", check=False, timeout=60)
                stopped = r.returncode == 0 and f"[{args.session}]" not in r.stdout
            if stopped:
                _kill_watchdog(args.session)
            else:
                log(f"WARNING: could not confirm the stop; the watchdog is still armed. Run `fluxx status` now.")
            log(f"session {'stopped' if stopped else 'NOT CONFIRMED STOPPED'} after {mins:.1f} min{cost}")
        signal.signal(signal.SIGINT, signal.default_int_handler)
        lock.close()


# ---------------------------------------------------------------- accounts

def urlopen(req, timeout: float = 30):
    """HTTPS with the CA bundle colab_env() found: python.org / uv Pythons on macOS ship without one."""
    ctx = ssl.create_default_context(cafile=colab_env().get("SSL_CERT_FILE"))
    return urllib.request.urlopen(req, timeout=timeout, context=ctx)


def hf_token() -> str | None:
    tok = os.environ.get("HF_TOKEN") or (HF_TOKEN_FILE.read_text().strip() if HF_TOKEN_FILE.exists() else "")
    return tok or None


def hf_access(tok: str) -> str:
    """'ok', 'license' (token fine, FLUX license not accepted yet) or 'token' (token rejected)."""
    req = urllib.request.Request(f"https://huggingface.co/{MODEL}/resolve/main/model_index.json",
                                 method="HEAD", headers={"Authorization": f"Bearer {tok}"})
    for path in ("model_index.json", "modular_model_index.json"):
        req.full_url = f"https://huggingface.co/{MODEL}/resolve/main/{path}"
        try:
            urlopen(req, timeout=20)
            return "ok"
        except urllib.error.HTTPError as e:
            if e.code == 401:
                return "token"
            if e.code == 403:
                return "license"
    return "ok"  # 404 on both names means access was granted but the layout changed: let the VM try


def weight_hashes(repo: str) -> dict:
    url = f"https://huggingface.co/api/models/{repo}?blobs=true"
    with urlopen(url) as r:
        sib = json.load(r).get("siblings", [])
    return {s["rfilename"]: s["lfs"]["sha256"] for s in sib
            if s.get("lfs") and re.match(r"(transformer|text_encoder|vae)/.*\.safetensors$", s["rfilename"])}


def mirror_matches() -> bool:
    """True when every weight file in the mirror has the official file's sha256 (both listings are public)."""
    try:
        official, mirror = weight_hashes(MODEL), weight_hashes(MIRROR)
    except (OSError, ValueError, KeyError):
        return False
    return bool(official) and official == mirror


def pick_source() -> tuple[str, str | None]:
    """(repo to download from, token to upload or None)."""
    tok = hf_token()
    if tok and hf_access(tok) == "ok":
        return MODEL, tok
    if MIRROR and mirror_matches():
        log(f"no Hugging Face token with FLUX 3 access: using the public mirror {MIRROR} "
            f"(weights verified identical to {MODEL}; the FLUX license applies the same)")
        return MIRROR, None
    raise FluxxError(f"no access to {MODEL} and the mirror could not be verified: run `fluxx login`")


def cmd_login(_args) -> int:
    if not shutil.which("colab"):
        raise FluxxError("Colab CLI not installed: run install.sh first")
    if COLAB_TOKEN.exists():
        print("Google (Colab): already signed in.")
    else:
        print("Google (Colab): a browser opens for sign-in. On a server, open the printed link anywhere "
              "and paste the code back here.")
        subprocess.run(["colab", "usage"], env=colab_env())
    tok = hf_token()
    if tok and hf_access(tok) == "ok":
        print("Hugging Face: token saved and FLUX 3 license accepted.")
        return 0
    print(f"\nHugging Face, two steps (free):\n"
          f"  1. Open https://huggingface.co/{MODEL} , sign in, and accept the FLUX license.\n"
          f"  2. Create a Read token at https://huggingface.co/settings/tokens and paste it below.\n")
    while True:
        tok = getpass.getpass("Hugging Face token (input hidden, empty to skip): ").strip()
        if not tok:
            print("Skipped. Run `fluxx login` again when ready.")
            return 1
        state = hf_access(tok)
        if state == "token":
            print("That token was rejected. Copy it again from https://huggingface.co/settings/tokens")
            continue
        HF_TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
        HF_TOKEN_FILE.write_text(tok)
        HF_TOKEN_FILE.chmod(0o600)
        if state == "license":
            print(f"Token saved, but the license is not accepted yet: open https://huggingface.co/{MODEL} "
                  f"and click agree, then run `fluxx doctor`.")
            return 1
        print(f"Token saved to {HF_TOKEN_FILE} and FLUX 3 access confirmed.")
        return 0


def cmd_doctor(_args) -> int:
    rows, ok = [], True

    def row(good: bool, what: str, fix: str = "") -> None:
        nonlocal ok
        ok &= good
        rows.append(f"{'ok  ' if good else 'TODO'} {what}" + ("" if good else f"\n     -> {fix}"))

    row(bool(shutil.which("colab")), "Colab CLI installed", "run install.sh (or: uv tool install google-colab-cli)")
    row(COLAB_TOKEN.exists(), "signed in to Google for Colab", "fluxx login")
    if COLAB_TOKEN.exists() and shutil.which("colab"):
        u = colab("usage", check=False, timeout=60).stdout
        m = re.search(r"balance[^\d]*([\d.]+)", u, re.I)
        row(not m or float(m.group(1)) > 1, f"Colab compute units: {m.group(1) if m else 'unknown'}",
            "buy compute units or Colab Pro: https://colab.research.google.com/signup")
    tok = hf_token()
    state = hf_access(tok) if tok else "none"
    if state == "ok":
        row(True, "Hugging Face token with FLUX 3 license accepted (official weights)")
    else:
        row(mirror_matches(), f"model: public mirror {MIRROR}, verified identical (optional: `fluxx login` "
                              f"for the official repo)", "fluxx login (the mirror could not be verified)")
    brands = sorted(p.parent.name for p in (HOME / "brands").glob("*/brand.json"))
    row(bool(brands), f"brands: {', '.join(brands) or 'none'}", "fluxx brand new NAME (the skill walks you through it)")
    print("\n".join(rows))
    print("\nready" if ok else "\nnot ready yet: fix the TODO lines above")
    return 0 if ok else 1


# ---------------------------------------------------------------- brand commands

def cmd_brand(args) -> int:
    if args.action == "list":
        for p in sorted((HOME / "brands").glob("*/brand.json")):
            b = json.loads(p.read_text())
            print(f"{p.parent.name}: {b.get('business', '')}")
        return 0
    d = brand_dir(args.name)
    if args.action == "new":
        if (d / "brand.json").exists():
            raise FluxxError(f"brand '{args.name}' exists: edit {d / 'brand.json'}")
        (d / "refs").mkdir(parents=True, exist_ok=True)
        save_brand(args.name, {"business": args.business or "", "style": args.style or "",
                               "avoid": args.avoid or "", "aspect": args.aspect or "1:1",
                               "seed": int.from_bytes(os.urandom(3), "big"), "refs": [], "checks": [], "notes": []})
        print(d / "brand.json")
        return 0
    b = load_brand(args.name)
    if args.action == "ref":
        src = Path(args.image).expanduser()
        if not src.is_file():
            raise FluxxError(f"no such image: {src}")
        if len(b["refs"]) >= MAX_REFS:
            raise FluxxError(f"FLUX 3 takes at most {MAX_REFS} references; remove one from brand.json first")
        dst = d / "refs" / src.name
        shutil.copy2(src, dst)
        b["refs"].append({"path": str(dst), "role": args.role})
        save_brand(args.name, b)
        print(f"added {dst} as {args.role} reference ({len(b['refs'])}/{MAX_REFS})")
        return 0
    # show: the profile plus recent feedback, which is what an agent reads before writing shots
    print(f"# {d / 'brand.json'}\n{json.dumps(b, indent=1)}")
    rated = [h for h in history(args.name) if "verdict" in h][-15:]
    shots = {h["id"]: h for h in history(args.name) if "scene" in h}
    if rated:
        print("\n# recent feedback")
        for r in rated:
            s = shots.get(r["rate"], {})
            print(f"{r['verdict']:4} {r['rate']}: {s.get('scene', '')[:80]}" + (f"  -- {r['note']}" if r.get("note") else ""))
    print(f"\n{sum(1 for h in shots.values() if 'md' in h)} shots so far in {d / 'shots'}")
    return 0


def cmd_rate(args) -> int:
    key = Path(args.shot).name.removesuffix("_hd.png").removesuffix("_md.jpg")
    for hist in (HOME / "brands").glob("*/history.jsonl"):
        name = hist.parent.name
        recs = [h for h in history(name) if "scene" in h and (h["id"] == key or key in h["id"])]
        if recs:
            r = recs[-1]
            append_history(name, [{"rate": r["id"], "verdict": args.verdict, "note": args.note or "",
                                   "time": time.strftime("%Y-%m-%dT%H:%M:%S")}])
            print(f"{args.verdict}: {r['id']} ({name})")
            return 0
    raise FluxxError(f"no shot matching '{args.shot}'")


# ---------------------------------------------------------------- generate

def plan_shots(args, brand: dict) -> tuple[list[dict], list[dict]]:
    scenes = list(args.scenes)
    if args.from_file:
        scenes += [s.strip() for s in Path(args.from_file).read_text().splitlines()
                   if s.strip() and not s.lstrip().startswith("#")]
    if not scenes:
        raise FluxxError("no scenes: pass them as arguments or with --from FILE (one per line)")
    refs = list(brand.get("refs", [])) + [{"path": str(Path(p).expanduser()), "role": "product"} for p in args.ref]
    if args.no_refs:
        refs = []
    if len(refs) > MAX_REFS:
        raise FluxxError(f"{len(refs)} references; FLUX 3 takes at most {MAX_REFS}")
    for r in refs:
        if not Path(r["path"]).is_file():
            raise FluxxError(f"reference image missing: {r['path']}")
    seed = args.seed if args.seed is not None else int(brand.get("seed", 0))
    remote = {r["path"]: f"refs/{i}{Path(r['path']).suffix.lower()}" for i, r in enumerate(refs)}  # inside the job dir
    shots = []
    for i, scene in enumerate(scenes):
        m = re.match(r"\s*(\d+(?:\.\d+)?:\d+(?:\.\d+)?)\s*\|\s*(.+)", scene)  # "16:9 | scene" sets its aspect
        aspect = m.group(1) if m else args.aspect or brand.get("aspect") or "1:1"
        scene = m.group(2) if m else scene
        w, h = size_for(aspect, DRAFT_MP if args.draft else HD_MP)
        for k in range(args.n):
            role = (getattr(args, "roles", None) or {}).get(i)
            studio = role in STUDIO_ROLES
            look = {"business": brand.get("business"), "avoid": brand.get("avoid")} if studio else brand
            shots.append({"id": f"{i + 1:02d}-{role or slug(scene)}-v{k + 1}" if role else f"{i + 1:02d}-{slug(scene)}-v{k + 1}",
                          "scene": scene, "request": compose(scene, look, refs), "seed": seed + k, "width": w,
                          "height": h, "draft": args.draft, "refs": [remote[r["path"]] for r in refs],
                          "aspect": aspect, "role": role, "white": role == "main",
                          "ref_main": bool(role) and role != "main" and "main" in (args.roles or {}).values()})
    return shots, [{"local": p, "remote": rp} for p, rp in remote.items()]


# Listing mode: one picture per role, all square 4 MP, exported per marketplace on the GPU.
STUDIO_ROLES = ("main", "angle", "detail")  # plain studio shots: the brand's look is not applied
LISTING_SHOTS = [
    ("main", "{p} alone, centered, on a pure seamless white background, straight-on product photo at eye level, "
             "soft even studio lighting, sharp focus on the whole product, no props, no text, no shadows beyond a soft "
             "contact shadow"),
    ("angle", "{p} at a three-quarter angle on a pure seamless white background, soft studio lighting, no props, no text"),
    ("detail", "close-up of {p} showing its materials, texture and finest details, studio macro photograph, "
               "shallow depth of field, clean neutral background"),
    ("lifestyle", "{p} in a real setting where it is used, styled for its buyers, natural and inviting"),
    ("scale", "{p} on a table next to familiar everyday objects that make its real size obvious, natural light"),
    ("gift", "{p} presented as a gift or in a person's hands, warm and personal, face of the person not shown"),
]
COPY_LIMITS = {  # field -> (max, unit); checked locally whatever the model wrote
    "amazon": {"title": (75, "chars"), "item_highlights": (125, "chars"), "bullets": (200, "chars each"),
               "description": (2000, "chars"), "search_terms": (250, "bytes")},
    "etsy": {"title": (140, "chars"), "tags": (20, "chars each"), "description": (5000, "chars")},
    "ebay": {"title": (80, "chars"), "description": (4000, "chars")},
    "shopify": {"title": (70, "chars"), "seo_title": (60, "chars"), "seo_description": (160, "chars")},
}
TAG_COUNT = {"etsy": 13, "shopify": 10}


def clip(text: str, limit: int, unit: str = "chars") -> str:
    """Cut at the last word boundary within the limit (bytes in UTF-8 for Amazon search terms)."""
    text = " ".join(str(text).split())
    size = (lambda t: len(t.encode())) if unit == "bytes" else len
    if size(text) <= limit:
        return text
    words, out = text.split(" "), ""
    for w in words:
        cand = f"{out} {w}".strip()
        if size(cand) > limit:
            break
        out = cand
    return out.rstrip(" ,;:-")


def check_copy(market: str, copy: dict) -> tuple[dict, list[str]]:
    """Enforce each marketplace's limits; returns the fixed copy and what was changed."""
    fixed, notes = dict(copy), []
    for field, (limit, unit) in COPY_LIMITS.get(market, {}).items():
        val = fixed.get(field)
        if isinstance(val, list):
            keep = []
            for v in val:
                c = clip(v, limit, "chars")
                if not c or (field == "tags" and len(str(v).strip()) > limit):
                    notes.append(f"{field}: dropped '{v}' (over {limit} {unit})")
                    continue
                if c != " ".join(str(v).split()):
                    notes.append(f"{field}: shortened one to {limit} {unit}")
                keep.append(c)
            if field == "tags":
                keep = list(dict.fromkeys(t.lower() for t in keep))[:TAG_COUNT.get(market, len(keep))]
                if len(keep) < TAG_COUNT.get(market, 0):
                    notes.append(f"tags: {len(keep)} of {TAG_COUNT[market]}; add more by hand")
            fixed[field] = keep
        elif isinstance(val, str):
            c = clip(val, limit, unit.split()[0])
            if c != " ".join(val.split()):
                notes.append(f"{field}: shortened to {limit} {unit.split()[0]}")
            fixed[field] = c
    if market == "amazon" and len(fixed.get("bullets", [])) != 5:
        notes.append(f"bullets: {len(fixed.get('bullets', []))} instead of 5")
    return fixed, notes


def copy_markdown(market: str, copy: dict, notes: list[str]) -> str:
    lines = [f"# {market.capitalize()} listing (draft, check every fact before publishing)", ""]
    for k, v in copy.items():
        if k in ("error", "raw"):
            continue
        n = f" ({len(v.encode()) if k == 'search_terms' else len(v)} {'bytes' if k == 'search_terms' else 'chars'})" \
            if isinstance(v, str) else ""
        lines.append(f"## {k.replace('_', ' ')}{n}")
        if isinstance(v, list):
            lines += [f"- {x}" for x in v]
        elif isinstance(v, dict):
            lines += [f"- **{a}**: {b}" for a, b in v.items()]
        else:
            lines.append(str(v))
        lines.append("")
    if notes:
        lines += ["## fixed by fluxx", *[f"- {n}" for n in notes], ""]
    if copy.get("error"):
        lines += ["## the model's reply could not be read", "```", copy.get("raw", ""), "```"]
    return "\n".join(lines)


def cmd_listing(args) -> int:
    markets = [m.strip().lower() for m in args.markets.split(",") if m.strip()]
    bad = [m for m in markets if m not in COPY_LIMITS]
    if bad:
        raise FluxxError(f"unknown marketplace {bad}; choose from {', '.join(COPY_LIMITS)}")
    roles = [r for r, _ in LISTING_SHOTS if not args.only or r in args.only.split(",")]
    args.scenes = [f"1:1 | {dict(LISTING_SHOTS)[r].format(p=args.product)}" for r in roles]
    args.roles = dict(enumerate(roles))
    args.from_file, args.n, args.aspect = None, 1, None
    brand = load_brand(args.brand)
    args.listing = {"markets": markets, "product": args.product, "notes": args.notes or "",
                    "business": brand.get("business", "")}
    return cmd_gen(args)


def cmd_gen(args) -> int:
    brand = load_brand(args.brand)
    cfg = config()
    args.keep = cfg["keep_minutes"] if args.keep is None else args.keep
    if args.candidates is None:
        args.candidates = 1 if args.draft else int(cfg["candidates"])
    shots, uploads = plan_shots(args, brand)
    source, tok = pick_source()
    out = Path(args.out).expanduser() if args.out else brand_dir(args.brand) / "shots" / time.strftime("%Y%m%d-%H%M%S")
    out.mkdir(parents=True, exist_ok=True)
    mode = {"model": MODEL, "source": source, "upsample": not args.no_upsample, "judge": True}
    spec = {"md_side": MD_SIDE, "candidates": args.candidates, "avoid": brand.get("avoid", ""),
            "checks": brand.get("checks", []), "shots": shots}
    if getattr(args, "listing", None):
        spec["listing"] = args.listing
    sizes = sorted({f"{s['width']}x{s['height']}" for s in shots})
    log(f"{len(shots)} shot(s) at {', '.join(sizes)}, up to {args.candidates} candidate(s) each, judged; "
        f"{len(uploads)} reference(s) -> {out}")

    job = f"{REMOTE}/jobs/j{time.time_ns()}"
    with tempfile.TemporaryDirectory() as tmp, gpu_session(args, mode) as info:
        rexec(args.session, f'import os\nos.makedirs("{job}/refs", exist_ok=True)\n'
                            'print(BEGIN); print("{}"); print(END)', 60)
        files = [(u["local"], f"{job}/{u['remote']}") for u in uploads]
        if not info["warm"]:
            wp = Path(tmp) / "worker.json"
            wp.write_text(json.dumps({**mode, "idle_exit_s": 6 * 3600}))  # the VM itself is stopped by the watchdog
            files += [(str(HERE / "remote_job.py"), f"{REMOTE}/remote_job.py"), (str(wp), f"{REMOTE}/worker.json")]
            if tok:
                tp = Path(tmp) / "hf_token"
                tp.write_text(tok)
                tp.chmod(0o600)
                files.append((str(tp), f"{REMOTE}/hf_token"))
        sp = Path(tmp) / "spec.json"
        sp.write_text(json.dumps(spec))
        files.append((str(sp), f"{job}/spec.json"))  # last: the worker starts a job once its spec exists
        for local, remote in files:
            colab("upload", "-s", args.session, local, remote, timeout=300)
        if not info["warm"]:
            rexec(args.session, LAUNCH, 60)
            log("worker started: installing, downloading FLUX 3 Klein and the judge, loading them (~3-4 min)")
        last, misses, deadline = None, 0, time.time() + args.max_minutes * 60 - 120
        while time.time() < deadline:
            time.sleep(10)
            try:
                st = rexec(args.session, f"JOB = {job!r}\n" + POLL, 60)
                misses = 0
            except FluxxError:
                misses += 1  # a dropped websocket: try again
                if misses >= 8:
                    raise
                continue
            line = st["stage"] + (f" {st['done'] + (st['stage'] == 'rendering')}/{st['total']}" if "total" in st else "") \
                + (f" candidate {st['candidate']}/{st['of']}" if st.get("of", 1) > 1 else "")
            if line != last:
                log(line)
                last = line
            if st["stage"] == "failed":
                raise FluxxError("the job failed on the VM:\n" + (st.get("error") or "") + (st.get("log") or ""))
            if st["stage"] == "finished":
                info["ready_s"], info["note"] = st.get("ready_s"), st.get("note")
                break
        else:
            raise FluxxError(f"not finished within --max-minutes {args.max_minutes:g}; nothing downloaded")
        zp = Path(tmp) / "out.zip"
        for attempt in range(3):
            if colab("download", "-s", args.session, f"{job}/out.zip", str(zp), check=False, timeout=900).returncode == 0 \
                    and zipfile.is_zipfile(zp):
                break
            time.sleep(3)
        else:
            raise FluxxError("could not download the pictures from the VM")
        with zipfile.ZipFile(zp) as z:
            z.extractall(out)
        info["keep"] = True

    manifest = json.loads((out / "manifest.json").read_text())
    now, recs, failed = time.strftime("%Y-%m-%dT%H:%M:%S"), [], 0
    by_id = {s["id"]: s for s in shots}
    for r in manifest["shots"]:
        if r["id"] not in by_id:  # e.g. the listing step's own error row
            log(f"{r['id']}: FAILED {r.get('error', '')[:300]}")
            failed += 1
            continue
        rec = {"id": r["id"], "time": now, "scene": r["scene"], "caption": r.get("caption", ""), "seed": r.get("seed"),
               "aspect": by_id[r["id"]]["aspect"], "size": f"{r['width']}x{r['height']}",
               "score": r.get("score"), "defects": r.get("defects", []),
               "alts": [str(out / c["alt"]) for c in r.get("candidates", []) if c.get("alt")]}
        for k in ("hd", "md"):
            if r.get(k):
                rec[k] = str(out / r[k])
        if r.get("error"):
            rec["error"] = r["error"]
            failed += 1
            log(f"{r['id']}: FAILED {r['error'][:200]}")
        recs.append(rec)
        if "md" in rec:
            print(rec.get("hd") or rec["md"])
            tried = len(r.get("candidates", [])) or 1
            judged = f"score {rec['score']}/10" if rec["score"] is not None else "not judged"
            log(f"{r['id']}: {judged}, best of {tried}" + (f"; defects: {'; '.join(rec['defects'])}" if rec["defects"] else ""))
    append_history(args.brand, recs)
    for cj in sorted((out / "markets").glob("*/copy.json")):
        market = cj.parent.name
        fixed, notes = check_copy(market, json.loads(cj.read_text()))
        cj.write_text(json.dumps(fixed, indent=1) + "\n")
        (cj.parent / "listing.md").write_text(copy_markdown(market, fixed, notes))
        pics = len(list(cj.parent.glob("*.jpg")))
        log(f"{market}: {pics} pictures + listing.md -> {cj.parent}" + (f" ({len(notes)} fix(es))" if notes else ""))
    log(f"{len(recs) - failed}/{len(recs)} pictures in {manifest.get('job_s', '?')}s on {manifest.get('gpu', '?')}"
        + (f", model ready after {info['ready_s']}s" if not info["warm"] and info.get("ready_s") else "")
        + (f" ({info['note']})" if info.get("note") else "") + f" -> {out}")
    return 1 if failed else 0


def cmd_config(args) -> int:
    cfg = config()
    if args.key and args.value is not None:
        if args.value < 0 or (args.key == "candidates" and not 1 <= args.value <= 8):
            raise FluxxError("keep_minutes >= 0; candidates 1..8")
        cfg[args.key] = int(args.value) if args.value == int(args.value) else args.value
        HOME.mkdir(parents=True, exist_ok=True)
        (HOME / "config.json").write_text(json.dumps(cfg, indent=1) + "\n")
    print(json.dumps({k: cfg[k] for k in ([args.key] if args.key else cfg)}, indent=1))
    return 0


def cmd_stop(args) -> int:
    r = colab("stop", "-s", args.session, check=False)
    print((r.stdout + r.stderr).strip())
    _kill_watchdog(args.session)
    warm_file(args.session).unlink(missing_ok=True)
    return r.returncode


def cmd_status(_args) -> int:
    for sub in ("sessions", "usage"):
        print((colab(sub, check=False, timeout=60).stdout).strip())
    return 0


def cmd_selftest(_args) -> int:
    assert size_for("1:1", 4) == (2048, 2048)
    assert size_for("1:1", 1) == (1024, 1024)
    w, h = size_for("4:5", 4)
    assert w % 32 == 0 and h % 32 == 0 and abs(w / h - 0.8) < 0.02 and 3.8e6 < w * h < 4.3e6
    w, h = size_for("16:9", 4)
    assert w > h and w % 32 == 0
    for bad in ("square", "1:9"):
        try:
            size_for(bad, 4)
            raise AssertionError(bad)
        except FluxxError:
            pass
    req = compose("A candle on a marble table", {"business": "a candle shop", "style": "soft light", "avoid": "text"},
                  [{"role": "product"}, {"role": "style"}])
    assert req.startswith("A candle on a marble table. It is for a candle shop.") and "image 2 is a style" in req
    assert compose("x", {}, []) == "x."
    assert slug("Hero shot: on oak!") == "hero-shot-on-oak"
    assert payload(f"noise\n{BEGIN}\n{{\"a\": 1}}\n{END}") == {"a": 1}
    try:
        payload("Traceback: boom")
        raise AssertionError("missing marker must raise")
    except FluxxError as e:
        assert "boom" in str(e)
    try:
        brand_dir("Bad Name")
        raise AssertionError("bad brand name accepted")
    except FluxxError:
        pass
    ns = argparse.Namespace(scenes=["16:9 | wide hero", "plain"], from_file=None, ref=[], no_refs=False, n=2,
                            aspect=None, draft=False, seed=None)
    shots, _ = plan_shots(ns, {"aspect": "4:5", "seed": 7})
    assert [s["aspect"] for s in shots] == ["16:9", "16:9", "4:5", "4:5"] and shots[0]["scene"] == "wide hero"
    assert [s["seed"] for s in shots[:2]] == [7, 8] and shots[0]["width"] > shots[0]["height"]
    shots, ups = plan_shots(argparse.Namespace(scenes=["x"], from_file=None, ref=[__file__], no_refs=False, n=1,
                                               aspect=None, draft=True, seed=None), {})
    assert shots[0]["refs"] == ["refs/0"] and ups[0]["remote"] == "refs/0" and shots[0]["width"] == 1024
    assert clip("Red Rotary Telephone Vintage Style Corded Desk Phone", 20) == "Red Rotary Telephone"
    assert clip("a b c", 3, "bytes") == "a b" and len(clip("é" * 200, 250, "bytes").encode()) <= 250
    fixed, notes = check_copy("etsy", {"title": "x" * 150, "tags": ["ok tag", "a tag that is far too long", "OK TAG"]})
    assert len(fixed["title"]) <= 140 and fixed["tags"] == ["ok tag"] and any("dropped" in n for n in notes)
    fixed, notes = check_copy("amazon", {"title": "word " * 30, "bullets": ["b"] * 4, "search_terms": "w " * 200})
    assert len(fixed["title"]) <= 75 and len(fixed["search_terms"].encode()) <= 250 and any("bullets" in n for n in notes)
    ns = argparse.Namespace(scenes=["1:1 | main", "1:1 | life"], roles={0: "main", 1: "lifestyle"}, from_file=None,
                            ref=[], no_refs=False, n=1, aspect=None, draft=False, seed=None)
    shots, _ = plan_shots(ns, {"style": "moody", "business": "b"})
    assert shots[0]["white"] and "moody" not in shots[0]["request"] and "moody" in shots[1]["request"]
    assert shots[0]["id"] == "01-main-v1" and not shots[0]["ref_main"] and shots[1]["ref_main"]
    compile((HERE / "remote_job.py").read_text(), "remote_job.py", "exec")
    for code in (LAUNCH, "JOB = ''\n" + POLL, HEARTBEAT):
        compile(f"BEGIN=END=''\nimport json\n{code}", "remote", "exec")
    print("selftest ok")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="fluxx", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("login", help="Google sign-in for Colab + Hugging Face token").set_defaults(fn=cmd_login)
    sub.add_parser("doctor", help="what is set up, what is missing").set_defaults(fn=cmd_doctor)

    p = sub.add_parser("brand", help="brand profiles: new, ref, show, list")
    p.add_argument("action", choices=("new", "ref", "show", "list"))
    p.add_argument("name", nargs="?")
    p.add_argument("image", nargs="?", help="for `ref`: the picture to add")
    p.add_argument("--role", choices=tuple(ROLES), default="product")
    p.add_argument("--business")
    p.add_argument("--style")
    p.add_argument("--avoid")
    p.add_argument("--aspect")
    p.set_defaults(fn=cmd_brand)

    p = sub.add_parser("gen", help="render shots in one GPU session")
    p.add_argument("-b", "--brand", required=True)
    p.add_argument("scenes", nargs="*", help="one scene per argument")
    p.add_argument("--from", dest="from_file", help="file with one scene per line")
    p.add_argument("-n", type=int, default=1, help="variations per scene (seed, seed+1, ...)")
    p.add_argument("--aspect", help="W:H, default the brand's")
    p.add_argument("--draft", action="store_true", help="1 MP medium only: faster, for exploring")
    p.add_argument("--ref", action="append", default=[], help="extra product reference for this run")
    p.add_argument("--no-refs", action="store_true", help="ignore the brand's references")
    p.add_argument("--seed", type=int, help="default the brand's seed, for consistency")
    p.add_argument("--no-upsample", action="store_true",
                   help="scenes are complete captions: skip FLUX 3's prompt upsampler (saves a 19 GB download)")
    p.add_argument("--out", help="output folder (default ~/colab-flux/brands/NAME/shots/<time>)")
    p.add_argument("-s", "--session", default="flux-gpu")
    p.add_argument("--gpu", default=os.environ.get("FLUXX_GPU", "A100,H100"),
                   help="GPU, or a comma list tried in order when one is busy (default A100,H100, both 80 GB)")
    p.add_argument("--high-mem", action=argparse.BooleanOptionalAction, default=True,
                   help="on A100 this is the 80 GB card (default); the model plus upsampler need ~40 GB")
    p.add_argument("--max-minutes", type=float, default=60, help="hard cap for this run (watchdog)")
    p.add_argument("--keep", type=float, help="minutes to keep the GPU warm afterwards for a follow-up run "
                                            "(default: config keep_minutes, 5; 0 = stop at once)")
    p.add_argument("--candidates", type=int, help="renders per shot; the judge keeps the best "
                                                  "(default: config candidates, 3; 1 with --draft)")
    p.set_defaults(fn=cmd_gen)

    p = sub.add_parser("listing", help="marketplace listing pack: pictures per site + drafted copy")
    p.add_argument("-b", "--brand", required=True)
    p.add_argument("--product", required=True, help="what it is, e.g. 'hand-poured soy candle in an amber jar'")
    p.add_argument("--for", dest="markets", default="amazon,etsy,ebay,shopify", help="comma list (default all four)")
    p.add_argument("--notes", help="facts for the copy: size, materials, what is included, care")
    p.add_argument("--only", help="comma list of roles: main,angle,detail,lifestyle,scale,gift")
    p.add_argument("--ref", action="append", default=[], help="product photo for this listing")
    p.add_argument("--no-refs", action="store_true", help="ignore the brand's references (another product)")
    for a, kw in (("--draft", {"action": "store_true"}), ("--seed", {"type": int}), ("--out", {}),
                  ("--no-upsample", {"action": "store_true"}), ("-s", {"dest": "session", "default": "flux-gpu"}),
                  ("--gpu", {"default": os.environ.get("FLUXX_GPU", "A100,H100")}),
                  ("--high-mem", {"action": argparse.BooleanOptionalAction, "default": True}),
                  ("--max-minutes", {"type": float, "default": 60}), ("--keep", {"type": float}),
                  ("--candidates", {"type": int})):
        p.add_argument(a, **kw)
    p.set_defaults(fn=cmd_listing)

    p = sub.add_parser("config", help="show or set defaults: keep_minutes, candidates")
    p.add_argument("key", nargs="?", choices=tuple(CONFIG_DEFAULTS))
    p.add_argument("value", nargs="?", type=float)
    p.set_defaults(fn=cmd_config)

    p = sub.add_parser("rate", help="good/bad feedback on a shot")
    p.add_argument("shot", help="shot id or picture path")
    p.add_argument("verdict", choices=("good", "bad"))
    p.add_argument("note", nargs="?")
    p.set_defaults(fn=cmd_rate)

    for name, fn in (("stop", cmd_stop), ("status", cmd_status), ("selftest", cmd_selftest)):
        p = sub.add_parser(name)
        p.add_argument("-s", "--session", default="flux-gpu")
        p.set_defaults(fn=fn)

    args = ap.parse_args()
    if args.cmd == "brand" and args.action != "list" and not args.name:
        ap.error("brand NAME is required")
    if args.cmd == "gen" and not 1 <= args.n <= 16:
        ap.error("-n must be 1..16")
    if args.cmd in ("gen", "listing") and args.candidates is not None and not 1 <= args.candidates <= 8:
        ap.error("--candidates must be 1..8")
    try:
        return args.fn(args)
    except FluxxError as e:
        log(f"error: {e}")
        return 1
    except KeyboardInterrupt:
        log("interrupted; see the stop line above")
        return 130


if __name__ == "__main__":
    sys.exit(main())
